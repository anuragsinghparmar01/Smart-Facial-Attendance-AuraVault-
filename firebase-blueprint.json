{
  "entities": {
    "FacialProfile": {
      "title": "FacialProfile",
      "description": "Stores enrolled person details (Name, Branch, Date of Birth, Roll Number, Phone Number) and normalized cloud facial biometric traits.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Workspace or authenticated user UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the enrolled person.",
          "minLength": 2,
          "maxLength": 80
        },
        "employeeCode": {
          "type": "string",
          "description": "Roll number or ID code.",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "branch": {
          "type": "string",
          "description": "Branch or department.",
          "minLength": 2,
          "maxLength": 60
        },
        "roleTitle": {
          "type": "string",
          "description": "Role or summary.",
          "minLength": 2,
          "maxLength": 60
        },
        "dateOfBirth": {
          "type": "string",
          "description": "Date of birth of the enrolled person.",
          "minLength": 1,
          "maxLength": 40
        },
        "phoneNumber": {
          "type": "string",
          "description": "Contact phone number of the enrolled person.",
          "minLength": 1,
          "maxLength": 40
        },
        "traitSignature": {
          "type": "string",
          "description": "Serialized normalized 32-D facial feature vector.",
          "minLength": 16,
          "maxLength": 2048
        },
        "interocularRatio": {
          "type": "number",
          "description": "Normalized interocular distance ratio."
        },
        "symmetryScore": {
          "type": "number",
          "description": "Biometric facial symmetry score from 0 to 100."
        },
        "descriptorHash": {
          "type": "string",
          "description": "Hexadecimal checksum of the facial trait vector.",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "description": "Enrollment status.",
          "enum": ["active", "suspended", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "ownerId",
        "fullName",
        "employeeCode",
        "branch",
        "roleTitle",
        "dateOfBirth",
        "phoneNumber",
        "traitSignature",
        "interocularRatio",
        "symmetryScore",
        "descriptorHash",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AttendanceLog": {
      "title": "AttendanceLog",
      "description": "Records a verified facial recognition attendance check-in with Name, Roll Number, Branch, DOB, Phone, Time, and GPS Location.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Workspace or user UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "profileId": {
          "type": "string",
          "description": "Document ID of the matched FacialProfile.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the person.",
          "minLength": 2,
          "maxLength": 80
        },
        "employeeCode": {
          "type": "string",
          "description": "Roll number at time of check-in.",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "branch": {
          "type": "string",
          "description": "Branch associated with the attendance record.",
          "minLength": 2,
          "maxLength": 60
        },
        "dateOfBirth": {
          "type": "string",
          "description": "Date of birth of the person.",
          "minLength": 1,
          "maxLength": 40
        },
        "phoneNumber": {
          "type": "string",
          "description": "Phone number of the person.",
          "minLength": 1,
          "maxLength": 40
        },
        "attendanceStatus": {
          "type": "string",
          "description": "Recorded attendance classification.",
          "enum": ["present", "late", "on_leave", "revoked"]
        },
        "verificationMethod": {
          "type": "string",
          "description": "Method used to verify attendance.",
          "enum": ["facial_biometric", "manual_admin_override"]
        },
        "matchConfidence": {
          "type": "number",
          "description": "Biometric facial similarity confidence score (0 to 100)."
        },
        "latitude": {
          "type": "number",
          "description": "GPS latitude coordinate (-90 to 90)."
        },
        "longitude": {
          "type": "number",
          "description": "GPS longitude coordinate (-180 to 180)."
        },
        "locationName": {
          "type": "string",
          "description": "Resolved location description and coordinate summary.",
          "minLength": 2,
          "maxLength": 160
        },
        "monthKey": {
          "type": "string",
          "description": "Year-month partition string (YYYY-MM).",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "dateKey": {
          "type": "string",
          "description": "ISO calendar date string (YYYY-MM-DD).",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "timeLabel": {
          "type": "string",
          "description": "Formatted local time of check-in.",
          "minLength": 4,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server timestamp when attendance was logged."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest record modification."
        }
      },
      "required": [
        "ownerId",
        "profileId",
        "fullName",
        "employeeCode",
        "branch",
        "dateOfBirth",
        "phoneNumber",
        "attendanceStatus",
        "verificationMethod",
        "matchConfidence",
        "latitude",
        "longitude",
        "locationName",
        "monthKey",
        "dateKey",
        "timeLabel",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator registry document keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "description": "Administrator role designation.",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin privilege was granted."
        }
      },
      "required": ["uid", "role", "createdAt"]
    }
  },
  "firestore": {
    "/facialProfiles/{profileId}": {
      "schema": {
        "$ref": "#/entities/FacialProfile"
      },
      "description": "Cloud store of enrolled user facial biometric traits and identity metadata."
    },
    "/attendanceLogs/{logId}": {
      "schema": {
        "$ref": "#/entities/AttendanceLog"
      },
      "description": "Real-time facial recognition attendance records with geolocation coordinates."
    },
    "/admins/{adminUid}": {
      "schema": {
        "$ref": "#/entities/AdminRecord"
      },
      "description": "Registry of administrator UIDs used by security rules for elevated access."
    }
  }
}
