rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'beh246914@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAllowedWorkspaceOwner(ownerId) {
      return ownerId == 'shared_workspace' || (isVerifiedUser() && ownerId == request.auth.uid);
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidFacialProfile(data) {
      return data.keys().hasAll([
          'ownerId', 'fullName', 'employeeCode', 'branch', 'roleTitle',
          'traitSignature', 'interocularRatio', 'symmetryScore',
          'descriptorHash', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'fullName', 'employeeCode', 'branch', 'roleTitle',
          'dateOfBirth', 'phoneNumber',
          'traitSignature', 'interocularRatio', 'symmetryScore',
          'descriptorHash', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 80 &&
        data.employeeCode is string && data.employeeCode.size() >= 1 && data.employeeCode.size() <= 32 && data.employeeCode.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.branch is string && data.branch.size() >= 2 && data.branch.size() <= 60 &&
        data.roleTitle is string && data.roleTitle.size() >= 2 && data.roleTitle.size() <= 60 &&
        (!('dateOfBirth' in data) || (data.dateOfBirth is string && data.dateOfBirth.size() <= 40)) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 40)) &&
        data.traitSignature is string && data.traitSignature.size() >= 16 && data.traitSignature.size() <= 2048 &&
        (data.interocularRatio is number || data.interocularRatio is int || data.interocularRatio is float) &&
        data.interocularRatio >= 0.05 && data.interocularRatio <= 1.0 &&
        (data.symmetryScore is number || data.symmetryScore is int || data.symmetryScore is float) &&
        data.symmetryScore >= 0 && data.symmetryScore <= 100 &&
        data.descriptorHash is string && data.descriptorHash.size() >= 8 && data.descriptorHash.size() <= 64 && data.descriptorHash.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.status is string && data.status.size() <= 20 && data.status in ['active', 'suspended', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAttendanceLog(data) {
      return data.keys().hasAll([
          'ownerId', 'profileId', 'fullName', 'employeeCode', 'branch',
          'attendanceStatus', 'verificationMethod', 'matchConfidence',
          'latitude', 'longitude', 'locationName', 'monthKey', 'dateKey',
          'timeLabel', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'profileId', 'fullName', 'employeeCode', 'branch',
          'dateOfBirth', 'phoneNumber',
          'attendanceStatus', 'verificationMethod', 'matchConfidence',
          'latitude', 'longitude', 'locationName', 'monthKey', 'dateKey',
          'timeLabel', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.profileId is string && data.profileId.size() >= 1 && data.profileId.size() <= 128 && data.profileId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 80 &&
        data.employeeCode is string && data.employeeCode.size() >= 1 && data.employeeCode.size() <= 32 && data.employeeCode.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.branch is string && data.branch.size() >= 2 && data.branch.size() <= 60 &&
        (!('dateOfBirth' in data) || (data.dateOfBirth is string && data.dateOfBirth.size() <= 40)) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 40)) &&
        data.attendanceStatus is string && data.attendanceStatus.size() <= 20 && data.attendanceStatus in ['present', 'late', 'on_leave', 'revoked'] &&
        data.verificationMethod is string && data.verificationMethod.size() <= 30 && data.verificationMethod in ['facial_biometric', 'manual_admin_override'] &&
        (data.matchConfidence is number || data.matchConfidence is int || data.matchConfidence is float) &&
        data.matchConfidence >= 0 && data.matchConfidence <= 100 &&
        (data.latitude is number || data.latitude is int || data.latitude is float) &&
        data.latitude >= -90 && data.latitude <= 90 &&
        (data.longitude is number || data.longitude is int || data.longitude is float) &&
        data.longitude >= -180 && data.longitude <= 180 &&
        data.locationName is string && data.locationName.size() >= 2 && data.locationName.size() <= 160 &&
        data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$') &&
        data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.timeLabel is string && data.timeLabel.size() >= 4 && data.timeLabel.size() <= 20 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, adminUid) {
      return data.keys().hasAll(['uid', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'role', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == adminUid &&
        data.role is string && data.role.size() <= 16 && data.role in ['admin'] &&
        data.createdAt is timestamp;
    }

    // 4. Collection Rules: /facialProfiles/{profileId}
    match /facialProfiles/{profileId} {
      allow get: if isValidId(profileId) && (
        isAllowedWorkspaceOwner(existing().ownerId) || isAdmin()
      );

      allow list: if isAllowedWorkspaceOwner(existing().ownerId) || isBootstrappedAdmin();

      allow create: if isValidId(profileId) &&
        isValidFacialProfile(incoming()) &&
        isAllowedWorkspaceOwner(incoming().ownerId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(profileId) &&
        isValidFacialProfile(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().status != 'archived' || isAdmin()) && (
          isAdmin() ||
          (
            isAllowedWorkspaceOwner(existing().ownerId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'employeeCode', 'branch', 'roleTitle', 'dateOfBirth', 'phoneNumber', 'status', 'updatedAt'
            ])
          ) ||
          (
            isAllowedWorkspaceOwner(existing().ownerId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'traitSignature', 'interocularRatio', 'symmetryScore', 'descriptorHash', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(profileId) && (
        isAllowedWorkspaceOwner(existing().ownerId) || isAdmin()
      );
    }

    // 5. Collection Rules: /attendanceLogs/{logId}
    match /attendanceLogs/{logId} {
      allow get: if isValidId(logId) && (
        isAllowedWorkspaceOwner(existing().ownerId) || isAdmin()
      );

      allow list: if isAllowedWorkspaceOwner(existing().ownerId) || isBootstrappedAdmin();

      allow create: if isValidId(logId) &&
        isValidAttendanceLog(incoming()) &&
        isAllowedWorkspaceOwner(incoming().ownerId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/facialProfiles/$(incoming().profileId));

      allow update: if isValidId(logId) &&
        isValidAttendanceLog(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().profileId == existing().profileId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().attendanceStatus != 'revoked' || isAdmin()) && (
          isAdmin() ||
          (
            isAllowedWorkspaceOwner(existing().ownerId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'employeeCode', 'branch', 'dateOfBirth', 'phoneNumber',
              'attendanceStatus', 'locationName', 'timeLabel', 'dateKey', 'monthKey', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(logId) && (
        isAllowedWorkspaceOwner(existing().ownerId) || isAdmin()
      );
    }

    // 6. Collection Rules: /admins/{adminUid}
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && isValidId(adminUid) && (
        request.auth.uid == adminUid || isAdmin()
      );

      allow list: if isBootstrappedAdmin();

      allow create: if isAdmin() &&
        isValidId(adminUid) &&
        isValidAdminRecord(incoming(), adminUid) &&
        incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isAdmin() && isValidId(adminUid);
    }
  }
}
